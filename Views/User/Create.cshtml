@model TotemPWA.Models.User
@{
    ViewBag.Title = "Novo Usuário";
    Layout = "~/Views/Shared/_CarrinhoLayout.cshtml";
}

<style>
    .container.mt-5 {
        background: #fff;
        justify-self: center;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 40px 32px 32px 32px;
        max-width: 600px;
        margin-top: 48px;
    }
    h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #b71c1c;
        margin-bottom: 32px;
        text-align: center;
        letter-spacing: 1px;
    }
    .form-label {
        font-weight: 600;
        color: #b71c1c;
        margin-bottom: 6px;
        letter-spacing: 0.5px;
    }
    .form-control {
        border-radius: 10px;
        border: 1.5px solid #e0e0e0;
        font-size: 1.15rem;
        padding: 12px 16px;
        margin-bottom: 8px;
        transition: border 0.2s;
        background: #fafafa;
    }
    .form-control:focus {
        border-color: #c1d343;
        box-shadow: 0 0 0 2px #c1d34344;
        background: #fff;
    }
    .input-group-text {
        background: #c1d343;
        color: #b71c1c;
        font-weight: bold;
        border: none;
        border-radius: 10px 0 0 10px;
    }
    .btn-primary, .btn-secondary {
        border-radius: 10px;
        font-size: 1.15rem;
        font-weight: 700;
        padding: 12px 32px;
        margin-right: 12px;
        margin-top: 18px;
        transition: background 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .btn-primary {
        background: #c1d343;
        color: #b71c1c;
        border: none;
    }
    .btn-primary:hover {
        background: #b6c12f;
        color: #b71c1c;
    }
    .btn-secondary {
        background: #b71c1c;
        color: #fff;
        border: none;
    }
    .btn-secondary:hover {
        background: #a31515;
    }
    .preview-img {
        display: block;
        margin: 0 auto 18px auto;
        max-width: 126px;
        max-height: 126px;
        border-radius: 8px;
        border: 1px solid #eee;
        object-fit: cover;
        background: #fafafa;
    }
</style>

<form asp-action="Create" method="post">
    <div class="container mt-5">
        <h1>Novo Usuário</h1>
        <div class="mb-3">
            <label asp-for="Login" class="form-label">Nome</label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-tag"></i>
                </span>
                <input asp-for="Login" class="form-control" required placeholder="Nome do usuário" />
            </div>
            <span asp-validation-for="Login" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Senha" class="form-label">Senha</label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-lock"></i>
                </span>
                <input asp-for="Senha" class="form-control" required type="password" placeholder="Senha do usuário" />
            </div>
            <span asp-validation-for="Senha" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>