@model List<TotemPWA.Models.User>

@{
    ViewBag.Title = "Usuários";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var Login = Context.Session.GetString("UserId");
}


<style>

</style>


<div class="content">
    <div class="container mt-5">
        <button onclick="location.href='@Url.Action("Dashboard", "Admin")'" class="btn btn-primary">
            Voltar
        </button>
        <h1>Usuários Disponíveis</h1>

        <button class="btn btn-primary" onclick="location.href = `/User/Create`;">Adicionar usuario</button>

        <br>


        @foreach (var user in Model)
        {
            <div class="contentIngredient ingrediente-@user.Id">
                <h2>@user.Login</h2>

                <form asp-action="Delete" method="post" >
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@user.Id" />
                    @if (Login != null && user.Id != int.Parse(Login))
                    {
                        <button type="submit" class="btn btn-danger">Excluir</button>
                    }
                </form>

                <button class="btn btn-primary" onclick="location.href = `/User/Editar?id=@user.Id`;">Editar</button>
            </div>
        }
    </div>
</div>
