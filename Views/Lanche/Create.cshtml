@model TotemPWA.Models.Product
@{
    ViewBag.Title = "Novo Lanche";
    Layout = "~/Views/Shared/_CarrinhoLayout.cshtml";
    var categoriasFilho = ViewBag.ChildCategories as List<Category>;
    var ingredientes = ViewBag.Ingredients as List<Ingredient>;
}

<style>
    .container.mt-5 {
        background: #fff;
        justify-self: center;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 40px 32px 32px 32px;
        max-width: 600px;
        margin-top: 48px;
    }
    h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #b71c1c;
        margin-bottom: 32px;
        text-align: center;
        letter-spacing: 1px;
    }
    .add-cupom-btn {
        background: #c1d343;
        color: #b71c1c;
        font-weight: 700;
        border: none;
        border-radius: 12px;
        padding: 12px 36px;
        font-size: 1.25rem;
        margin-bottom: 36px;
        margin-left: 50%;
        transform: translateX(-50%);
        display: block;
        transition: background 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .add-cupom-btn:hover {
        background: #b6c12f;
        color: #b71c1c;
    }
    .contentIngredient {
        background: #f7f7f7;
        border-radius: 16px;
        padding: 22px 20px 18px 20px;
        margin-bottom: 28px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }
    .contentIngredient h2 {
        font-size: 1.35rem;
        font-weight: 700;
        color: #b71c1c;
        margin: 0;
        flex: 1;
    }
    .cupom-info {
        flex: 2;
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 1.08rem;
        color: #b71c1c;
        font-weight: 500;
    }
    .btn-action-group {
        display: flex;
        gap: 18px;
    }
    .btn-danger {
        background: #b71c1c;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 12px 32px;
        font-size: 1.15rem;
        font-weight: 700;
        transition: background 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .btn-danger:hover {
        background: #a31515;
    }
    .btn-primary {
        background: #c1d343;
        color: #b71c1c;
        font-weight: 700;
        border: none;
        border-radius: 12px;
        padding: 12px 32px;
        font-size: 1.15rem;
        transition: background 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .btn-primary:hover {
        background: #b6c12f;
        color: #b71c1c;
    }

    .fotoIngrediente {
        max-width: 126px;
        max-height: 126px;
        width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: 8px;
        margin-right: 16px;
        border: 1px solid #eee;
        background: #fafafa;
    }
</style>

<form asp-action="Create" method="post">
    <div class="container mt-5">
        <h1>Novo Ingrediente</h1>
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Nome</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Descrição</label>
            <input asp-for="Description" class="form-control" required />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Preço</label>
            <input asp-for="Price" class="form-control" required type="number" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Sub-Categoria</label>
            <select asp-for="CategoryId" class="form-select">
                @if (categoriasFilho != null)
                {
                    foreach (var cat in categoriasFilho)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Foto" class="form-label">URL da Imagem</label>
            <input asp-for="Foto" class="form-control" />
            <span asp-validation-for="Foto" class="text-danger"></span>
        </div>

        <h3>Composição do Lanche</h3>
        <div class="mb-3">
            @if (ingredientes != null)
            {
                @for (int i = 0; i < ingredientes.Count; i++)
                {
                    var ing = ingredientes[i];
                    var comp = Model.Compositions?.FirstOrDefault(c => c.IngredientId == ing.Id);
                    bool isIncluded = comp != null;
                    int quantity = comp?.quantity ?? 1;

                    <div class="form-check d-flex align-items-center gap-2 mb-2">
                        <input type="checkbox" class="form-check-input" name="Compositions[@i].IsSelected" value="true"
                            @(isIncluded ? "checked" : "") />
                        <input type="hidden" name="Compositions[@i].IngredientId" value="@ing.Id" />
                        <label class="form-check-label">@ing.Name</label>
                        <input type="number" class="form-control ms-3" style="width:100px" name="Compositions[@i].Quantity"
                            value="@quantity" min="1" />
                    </div>
                }
            }

        <button type="submit" class="btn btn-primary">Salvar</button>
    </div>
</form>