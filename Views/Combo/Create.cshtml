@model ComboFormViewModel
@{
    ViewBag.Title = "Novo Combo";
    Layout = "~/Views/Shared/_WelcomeLayout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<style>
    .container.mt-5, .container.py-5 {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 40px 32px 32px 32px;
        max-width: 600px;
        margin-top: 48px;
    }
    h1 {
        font-size: 2.2rem;
        font-weight: 700;
        color: #b71c1c;
        margin-bottom: 40px;
        text-align: center;
        letter-spacing: 1px;
    }
    .mb-3 {
        margin-bottom: 1.7rem !important;
    }
    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 6px;
    }
    .form-control, .form-select, .form-control-lg, .form-select-lg {
        border-radius: 8px;
        border: 1.5px solid #e0e0e0;
        font-size: 1.08rem;
        padding: 10px 14px;
        transition: border 0.2s;
    }
    .form-control:focus, .form-select:focus, .form-control-lg:focus, .form-select-lg:focus {
        border-color: #b71c1c;
        box-shadow: 0 0 0 2px #c1d34344;
    }
    .btn-success, .btn-primary {
        background: #b71c1c;
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 8px;
        padding: 10px 28px;
        font-size: 1.1rem;
        margin-right: 16px;
        transition: background 0.2s;
    }
    .btn-success:hover, .btn-primary:hover {
        background: #a31515;
    }
    .btn-outline-secondary, .btn-secondary {
        background: #c1d343;
        color: #b71c1c;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        padding: 10px 28px;
        font-size: 1.1rem;
        transition: background 0.2s;
    }
    .btn-outline-secondary:hover, .btn-secondary:hover {
        background: #b6c12f;
        color: #b71c1c;
    }
    .contentIngredient {
        background: #f7f7f7;
        border-radius: 10px;
        padding: 22px 20px 18px 20px;
        margin-bottom: 22px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }
    .contentIngredient h2 {
        font-size: 1.3rem;
        font-weight: 600;
        color: #b71c1c;
        margin: 0;
        flex: 1;
    }
    .contentIngredient form,
    .contentIngredient .btn.btn-primary {
        margin-left: 10px;
    }
    .btn.btn-danger {
        background: #b71c1c;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 1rem;
        font-weight: 600;
        margin-right: 8px;
        transition: background 0.2s;
    }
    .btn.btn-danger:hover {
        background: #a31515;
    }
    /* Espaço maior entre título e botões */
    form .btn, .d-flex.justify-content-between .btn {
        margin-top: 32px;
    }
    .fotoIngrediente {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        margin-right: 16px;
        border: 1px solid #eee;
        background: #fafafa;
    }
</style>

<div class="container py-5">
    <div class="card shadow-lg rounded-4 p-4">
        <h1 >Criar Novo Combo</h1>

        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Combo.Name" class="form-label">Nome</label>
                <input asp-for="Combo.Name" class="form-control form-control-lg" required />
                <span asp-validation-for="Combo.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Combo.Description" class="form-label">Descrição</label>
                <textarea asp-for="Combo.Description" class="form-control form-control-lg" rows="3" required></textarea>
                <span asp-validation-for="Combo.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Combo.CategoryId" class="form-label">Categoria</label>
                <select asp-for="Combo.CategoryId" asp-items="ViewBag.Categories" class="form-select form-select-lg" required>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Value">@category.Text</option>
                    }
                </select>
                <span asp-validation-for="Combo.CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Combo.Foto" class="form-label">Foto (URL)</label>
                <input asp-for="Combo.Foto" class="form-control form-control-lg" type="url" required />
                <span asp-validation-for="Combo.Foto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Combo.Price" class="form-label">Preço</label>
                <input asp-for="Combo.Price" class="form-control form-control-lg" type="number" step="0.01" required />
                <span asp-validation-for="Combo.Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Produtos</label>
                <select asp-for="SelectedProductIds" asp-items="ViewBag.Products" class="form-select form-select-lg select2" multiple="multiple"></select>
            </div>


            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success px-4 py-2">Salvar</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('.select2').select2({
            placeholder: "Selecione os produtos",
            width: '100%'
        });
    });
</script>