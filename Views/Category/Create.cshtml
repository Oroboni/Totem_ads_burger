@model Category
@{
    ViewBag.Title = "Nova Categoria";
    Layout = "~/Views/Shared/_WelcomeLayout.cshtml";
    var categoriasPai = ViewBag.ParentCategories as List<Category>;
}

<style>
    .container.mt-5 {
        background: #fff;
        justify-self: center;
        border-radius: 14px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 40px 32px 32px 32px;
        max-width: 500px;
        margin-top: 48px;
    }
    h1 {
        font-size: 2.2rem;
        font-weight: 700;
        color: #b71c1c;
        margin-bottom: 32px;
        text-align: center;
        letter-spacing: 1px;
    }
    .mb-3 {
        margin-bottom: 1.7rem !important;
    }
    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 6px;
    }
    .form-control, .form-select {
        border-radius: 8px;
        border: 1.5px solid #e0e0e0;
        font-size: 1.08rem;
        padding: 10px 14px;
        transition: border 0.2s;
    }
    .form-control:focus, .form-select:focus {
        border-color: #b71c1c;
        box-shadow: 0 0 0 2px #c1d34344;
    }
    .btn-primary {
        background: #b71c1c;
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 8px;
        padding: 10px 28px;
        font-size: 1.1rem;
        margin-right: 16px;
        transition: background 0.2s;
    }
    .btn-primary:hover {
        background: #a31515;
    }
    .btn-secondary {
        background: #c1d343;
        color: #b71c1c;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        padding: 10px 28px;
        font-size: 1.1rem;
        transition: background 0.2s;
    }
    .btn-secondary:hover {
        background: #b6c12f;
        color: #b71c1c;
    }
    /* Espaço maior entre título e botões */
    form .btn {
        margin-top: 32px;
    }
</style>

<form asp-action="Create" method="post">
    <div class="container mt-5">
        <h1>Nova Categoria</h1>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Nome</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ParentCategoryId" class="form-label">Categoria Pai</label>
            <select asp-for="ParentCategoryId" class="form-select">
                <option value="">Nenhuma (Categoria Principal)</option>
                @if (categoriasPai != null)
                {
                    foreach (var cat in categoriasPai)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
            <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
