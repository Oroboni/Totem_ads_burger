@{
    ViewData["Title"] = "CPF na nota";
    Layout = null; // pra ignorar o layout padrão
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CPF na Nota</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <LINK rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></LINK>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
    
        body {
            font-family: 'Inter', sans-serif; 
        }
        
        .custom-checkbox:checked {
            background-color: #C1D343;
            border-color: #C1D343; 
        }
        .custom-checkbox:checked::before {
            content: '✓';
            display: block;
            color: white;
            text-align: center;
            line-height: 1.25rem; 
            font-size: 0.875rem; 
        }
        .cpf-input-placeholder::placeholder {
            color: #9ca3af; 
            letter-spacing: 0.1em;
        }
        .custom-button-color
        {
            background-color: #C1D343;
        }
        .custom-letter-color{
            color:#C30909;
            font-weight: bolder;
        }
        /* Deixe igual ao CPFnaNota */
        #numericKeypad {
            background: #1f2937; /* bg-gray-800 */
            padding: 0.75rem;
            border-radius: 0.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
            margin-top: 0.5rem;
        }
        .keypad-btn {
            background: #374151; /* bg-gray-700 */
            color: #fff;
            padding: 1rem;
            border-radius: 0.5rem;
            font-size: 1.5rem;
            font-weight: 600;
            transition: background 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .keypad-btn:hover, .keypad-btn:focus {
            background: #4b5563; /* hover:bg-gray-600 */
            outline: none;
        }
        .keypad-btn.text-lime-400 {
            color: #a3e635;
        }
    </style>
</head>
<body class="bg-gray-100 flex flex-col min-h-screen">

    <div class="flex-grow flex flex-col items-center justify-center p-4 w-full max-w-sm mx-auto">
        <h1 class="text-3xl font-bold text-gray-800 text-center mb-8">Desejar entrar com CPF para obter acesso a cupons?</h1>
        <div id="cpfSection" class="w-full space-y-6">
            <input type="text" id="cpfInput"
                class="custom-letter-color w-full p-3 text-xl text-center border border-gray-300 rounded-lg bg-white shadow-sm focus:ring-2 focus:ring-lime-400 focus:border-lime-400 cpf-input-placeholder"
                placeholder="___.___.___-__" style="margin-bottom: 1rem;" readonly>
            <div id="numericKeypad" class="grid grid-cols-3 gap-2 w-full max-w-xs mx-auto bg-gray-800 p-3 rounded-lg shadow-md">
                <!-- Row 1 -->
                <button data-key="7" class="keypad-btn">7</button>
                <button data-key="8" class="keypad-btn">8</button>
                <button data-key="9" class="keypad-btn">9</button>
                <!-- Row 2 -->
                <button data-key="4" class="keypad-btn">4</button>
                <button data-key="5" class="keypad-btn">5</button>
                <button data-key="6" class="keypad-btn">6</button>
                <!-- Row 3 -->
                <button data-key="1" class="keypad-btn">1</button>
                <button data-key="2" class="keypad-btn">2</button>
                <button data-key="3" class="keypad-btn">3</button>
                <!-- Row 4 -->
                <button data-key="clear" class="keypad-btn text-sm col-span-1">Limpar</button>
                <button data-key="0" class="keypad-btn">0</button>
                <button data-key="backspace" class="keypad-btn text-2xl"><i class="fa-solid fa-delete-left"></i></button>
            </div>
        </div>
        <!-- Botões de ação -->
        <div class="flex gap-4 justify-center">
            <button id="continueButton" class="bg-green-700 my-8 hover:bg-green-800 text-orange-50 font-semibold py-3 px-10 rounded-lg text-lg shadow-md transition duration-150" onclick="validarCPF()">
                Incluir o CPF
            </button> 
            <button id="continueButton" class="custom-button-color my-8 hover:bg-lime-500 text-orange-50 font-semibold py-3 px-10 rounded-lg text-lg shadow-md transition duration-150" onclick="location.href='@Url.Action("Pedido", "Home")'">
                Continuar sem CPF
            </button>
        </div>        
    </div>

    

    <script>
        const cpfSection = document.getElementById('cpfSection');
        const cpfInput = document.getElementById('cpfInput');
        const numericKeypad = document.getElementById('numericKeypad');
        const continueButton = document.getElementById('continueButton');
        const backButton = document.getElementById('backButton');
        let cpfValue = "";

        function formatCPF(value) {
            const digits = value.replace(/\D/g, ""); 
            let formatted = "";

            if (digits.length <= 3) {
                formatted = digits;
            } else if (digits.length <= 6) {
                formatted = `${digits.slice(0, 3)}.${digits.slice(3)}`;
            } else if (digits.length <= 9) {
                formatted = `${digits.slice(0, 3)}.${digits.slice(3, 6)}.${digits.slice(6)}`;
            } else {
                formatted = `${digits.slice(0, 3)}.${digits.slice(3, 6)}.${digits.slice(6, 9)}-${digits.slice(9, 11)}`;
            }
            return formatted;
        }


        function updateCpfInput() {
            const maskedValue = formatCPF(cpfValue);
            cpfInput.value = maskedValue;


            if (cpfValue.length === 0) {
                cpfInput.placeholder = "___.___.___-__";
            } else {
                const placeholderMask = "___.___.___-__";
                
                let displayValue = "";
                let rawIdx = 0;
                for (let i = 0; i < placeholderMask.length; i++) {
                    if (placeholderMask[i] === '_' && rawIdx < cpfValue.length) {
                    }
                }
            }
        }
        numericKeypad.addEventListener('click', function(event) {
            const target = event.target;
            if (target.classList.contains('keypad-btn')) {
                const key = target.dataset.key;

                if (key >= '0' && key <= '9') {
                    if (cpfValue.length < 11) {
                        cpfValue += key;
                    }
                } else if (key === 'backspace') {
                    cpfValue = cpfValue.slice(0, -1);
                } else if (key === 'clear') {
                    cpfValue = "";
                }
                updateCpfInput();
            }
        });


        document.querySelectorAll('.keypad-btn').forEach(btn => {
            btn.classList.add(
                'bg-gray-700', 'text-white', 'p-4', 'rounded-lg', 'text-2xl', 'font-semibold',
                'hover:bg-gray-600', 'focus:outline-none', 'focus:ring-2', 'focus:ring-lime-400',
                'transition', 'duration-150', 'ease-in-out', 'flex', 'items-center', 'justify-center'
            );
            if (btn.dataset.key === 'clear' || btn.dataset.key === 'backspace') {
                 btn.classList.add('text-lime-400');
            }
        });

        updateCpfInput();

    
        function TestaCPF(strCPF) {
            var Soma;
            var Resto;
            Soma = 0;

            // Verifica se todos os dígitos são iguais
            if (/^(\d)\1{10}$/.test(strCPF)) return false;

            for (i=1; i<=9; i++) Soma = Soma + parseInt(strCPF.substring(i-1, i)) * (11 - i);
            Resto = (Soma * 10) % 11;

            if ((Resto == 10) || (Resto == 11))  Resto = 0;
            if (Resto != parseInt(strCPF.substring(9, 10)) ) return false;

            Soma = 0;
            for (i = 1; i <= 10; i++) Soma = Soma + parseInt(strCPF.substring(i-1, i)) * (12 - i);
            Resto = (Soma * 10) % 11;

            if ((Resto == 10) || (Resto == 11))  Resto = 0;
            if (Resto != parseInt(strCPF.substring(10, 11) ) ) return false;
            return true;
        }
        
        function validarCPF(){
            let cpf = cpfInput.value.replace(/\D/g, "");
            if (cpf.length !== 11) {
                alert("CPF deve ter 11 dígitos");
                return;
            }
            if (TestaCPF(cpf)) {
                localStorage.setItem("clienteCPF", cpf); // Salva o CPF do cliente
                 window.location='@Url.Action("Pedido", "Home")';
            } else {
                alert("CPF inválido");
            }
        }
    </script>
</body>
</html>