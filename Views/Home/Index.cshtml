@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_WelcomeLayout.cshtml";
}




<a asp-area="" asp-controller="Home" asp-action="Pedido"></a>
<div class="content">
    <img id="logo" class="Image" src="img\LogoADSBurguer.png" alt="LogoADSBurguer" />

    <div>
        <h1 id="text-center">O MELHOR LANCHE DE SOROCABA</h1>
        <img id="combo" class="Image" src="\img\ComboCapa.png" />
        <img id="sombra" alt="" src="img\sombra 1.png">
    </div>

    <div class="Image botao">
        <a class="nav-link text-dark a" asp-area="" asp-controller="Home" asp-action="LoginCliente">Toque para iniciar</a>
    </div>

</div>
<script>
    function apagar(){
        localStorage.removeItem("cart");
        localStorage.removeItem("clienteCPF");
    }
    window.onload = function() {
        if (localStorage.getItem("cart")) {
            apagar();
        }
    };
</script>