@{
    ViewData["Title"] = "CPF na nota";
    Layout = null; // pra ignorar o layout padrão
}
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CPF na Nota</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <LINK rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    </LINK>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .custom-checkbox:checked {
            background-color: #C1D343;
            border-color: #C1D343;
        }

        .custom-checkbox:checked::before {
            content: '✓';
            display: block;
            color: white;
            text-align: center;
            line-height: 1.25rem;
            font-size: 0.875rem;
        }

        .cpf-input-placeholder::placeholder {
            color: #9ca3af;
            letter-spacing: 0.1em;
        }

        .custom-button-color {
            background-color: #C1D343;
        }

        .custom-letter-color {
            color: #C30909;
            font-weight: bolder;
        }
    </style>
</head>

<body class="bg-gray-100 flex flex-col min-h-screen">

    <div class="flex-grow flex flex-col items-center justify-center p-4 w-full max-w-sm mx-auto">
        <h1 class="text-3xl font-bold text-gray-800 text-center">DESEJA CPF NA NOTA?</h1>

        <div class="flex items-center space-x-3 mt-5">
            <input type="checkbox" id="incluirCpfCheckbox"
                class="custom-checkbox appearance-none w-6 h-6 border-2 border-gray-400 rounded-md cursor-pointer focus:ring-2 focus:ring-lime-300">
            <label for="incluirCpfCheckbox" class="text-lg text-gray-700 cursor-pointer">Sim, Desejo incluir o
                CPF</label>
        </div>
        <button id="continueButton"
            class="custom-button-color my-8 hover:bg-lime-500 text-orange-50 font-semibold py-3 px-10 rounded-lg text-lg shadow-md transition duration-150"
            onclick="TestaCPF()">
            Continuar
        </button>

        <!-- checkbox para CPF -->
        <div id="cpfSection" class="hidden w-full space-y-6">
            <input type="text" id="cpfInput"
                class="custom-letter-color w-full p-3 text-xl text-center border border-gray-300 rounded-lg bg-white shadow-sm focus:ring-2 focus:ring-lime-400 focus:border-lime-400 cpf-input-placeholder"
                placeholder="___.___.___-__" readonly>


            <div id="numericKeypad"
                class="grid grid-cols-3 gap-2 w-full max-w-xs mx-auto bg-gray-800 p-3 rounded-lg shadow-md">
                <!-- Row 1 -->
                <button data-key="7" class="keypad-btn">7</button>
                <button data-key="8" class="keypad-btn">8</button>
                <button data-key="9" class="keypad-btn">9</button>
                <!-- Row 2 -->
                <button data-key="4" class="keypad-btn">4</button>
                <button data-key="5" class="keypad-btn">5</button>
                <button data-key="6" class="keypad-btn">6</button>
                <!-- Row 3 -->
                <button data-key="1" class="keypad-btn">1</button>
                <button data-key="2" class="keypad-btn">2</button>
                <button data-key="3" class="keypad-btn">3</button>
                <!-- Row 4 -->
                <button data-key="clear" class="keypad-btn text-sm col-span-1">Limpar</button>
                <button data-key="0" class="keypad-btn">0</button>
                <button data-key="backspace" class="keypad-btn text-2xl"><i
                        class="fa-solid fa-delete-left"></i></button>
            </div>
        </div>


    </div>

    <footer class="bg-red-700 text-white p-4 w-full mt-auto">
        <div class="max-w-sm mx-auto flex justify-between items-center">
            <button onclick="history.back()" id=" backButton"
                class="bg-white hover:bg-gray-100 text-red-700 font-semibold py-2 px-6 rounded-lg shadow transition duration-150">
                Voltar
            </button>
            <span class="font-semibold text-lg" id="total-price"></span>
        </div>
    </footer>
    <script>
        window.addEventListener("DOMContentLoaded", () => { load(); });

        const incluirCpfCheckbox = document.getElementById('incluirCpfCheckbox');
        const cpfSection = document.getElementById('cpfSection');
        const cpfInput = document.getElementById('cpfInput');
        const numericKeypad = document.getElementById('numericKeypad');
        const continueButton = document.getElementById('continueButton');
        const backButton = document.getElementById('backButton');
        let cpfValue = "";

        function load() {
            const cart = JSON.parse(localStorage.getItem("cart") || "[]");
            const total = cart.reduce((sum, item) => sum + parseFloat(item.totalItemPrice || 0), 0);
            const price = document.getElementById("total-price");
            price.innerText = "Valor: R$ " + parseFloat(total).toFixed(2);
            console.log(cart);
        }

        function carrinho() {
            const savedCart = localStorage.getItem("cart");
            const Initial = JSON.parse(savedCart);
            const cart = Initial.filter(item => !item.CPF);
            const CPF = cpfValue;

            if (CPF != "") {
                cart.push({ CPF });
                localStorage.setItem("cart", JSON.stringify(cart));
            }
            console.log(cart);
            window.location.href = "@Url.Action("Editar", "Ingredient")";
        }

        function TestaCPF() {
            if (incluirCpfCheckbox.checked) {
                var Soma = 0;
                var Resto;
                const CPF = cpfValue;
                if ([
                    '00000000000',
                    '11111111111',
                    '22222222222',
                    '33333333333',
                    '44444444444',
                    '55555555555',
                    '66666666666',
                    '77777777777',
                    '88888888888',
                    '99999999999',
                ].indexOf(CPF) !== -1) {
                    alert("insira um cpf valido");
                    return false
                }
                for (i = 1; i <= 9; i++) Soma = Soma + parseInt(CPF.substring(i - 1, i)) * (11 - i);
                Resto = (Soma * 10) % 11;

                if ((Resto == 10) || (Resto == 11)) Resto = 0;
                if (Resto != parseInt(CPF.substring(9, 10))) {
                    alert("Insira um CPF valido");
                    return false;
                }

                Soma = 0;
                for (i = 1; i <= 10; i++) Soma = Soma + parseInt(CPF.substring(i - 1, i)) * (12 - i);
                Resto = (Soma * 10) % 11;

                if ((Resto == 10) || (Resto == 11)) Resto = 0;
                if (Resto != parseInt(CPF.substring(10, 11))) {
                    alert("Insira um CPF valido");
                    return false;
                } else {
                    carrinho();
                    return true;
                }
            }else{
                window.location.href = "@Url.Action("Index", "Ingredient")";
            }
            return false;
        }

        function formatCPF(value) {
            const digits = value.replace(/\D/g, "");
            let formatted = "";

            if (digits.length <= 3) {
                formatted = digits;
            } else if (digits.length <= 6) {
                formatted = `${digits.slice(0, 3)}.${digits.slice(3)}`;
            } else if (digits.length <= 9) {
                formatted = `${digits.slice(0, 3)}.${digits.slice(3, 6)}.${digits.slice(6)}`;
            } else {
                formatted = `${digits.slice(0, 3)}.${digits.slice(3, 6)}.${digits.slice(6, 9)}-${digits.slice(9, 11)}`;
            }
            return formatted;
        }


        function updateCpfInput() {
            const maskedValue = formatCPF(cpfValue);
            cpfInput.value = maskedValue;


            if (cpfValue.length === 0) {
                cpfInput.placeholder = "___.___.___-__";
            } else {
                const placeholderMask = "___.___.___-__";

                let displayValue = "";
                let rawIdx = 0;
                for (let i = 0; i < placeholderMask.length; i++) {
                    if (placeholderMask[i] === '_' && rawIdx < cpfValue.length) {
                    }
                }
            }
        }



        incluirCpfCheckbox.addEventListener('change', function () {
            if (this.checked) {
                cpfSection.classList.remove('hidden');
                cpfSection.classList.add('flex', 'flex-col', 'items-center');
            } else {
                cpfSection.classList.add('hidden');
                cpfSection.classList.remove('flex', 'flex-col', 'items-center');
                cpfValue = "";
                updateCpfInput();
            }
        });


        numericKeypad.addEventListener('click', function (event) {
            const target = event.target;
            if (target.classList.contains('keypad-btn')) {
                const key = target.dataset.key;

                if (key >= '0' && key <= '9') {
                    if (cpfValue.length < 11) {
                        cpfValue += key;
                    }
                } else if (key === 'backspace') {
                    cpfValue = cpfValue.slice(0, -1);
                } else if (key === 'clear') {
                    cpfValue = "";
                }
                updateCpfInput();
            }
        });


        document.querySelectorAll('.keypad-btn').forEach(btn => {
            btn.classList.add(
                'bg-gray-700', 'text-white', 'p-4', 'rounded-lg', 'text-2xl', 'font-semibold',
                'hover:bg-gray-600', 'focus:outline-none', 'focus:ring-2', 'focus:ring-lime-400',
                'transition', 'duration-150', 'ease-in-out', 'flex', 'items-center', 'justify-center'
            );
            if (btn.dataset.key === 'clear' || btn.dataset.key === 'backspace') {
                btn.classList.add('text-lime-400');
            }
        });


        if (incluirCpfCheckbox.checked) {
            cpfSection.classList.remove('hidden');
            cpfSection.classList.add('flex', 'flex-col', 'items-center');
        }
        updateCpfInput();

    </script>
</body>

</html>