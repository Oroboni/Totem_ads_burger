@{
    ViewBag.Title = "Carrinho";
    Layout = "~/Views/Shared/_WelcomeLayout.cshtml";
}

<link rel="stylesheet" href="~/css/Editar.css">
<div class="banner"></div>

<div class="content">
    <div class="container mt-5">
        <h1 class="text-center">Tela de Editar</h1>
        <div>
            <h2 for="">Hamburguer <img src="" alt="Queijo"></h2>
            <h3>Ingredientes</h3>
        </div>
        <div class="contentIngredient">
            <div>
                <button id="decreaseButton">--</button>
                <label class="labelNmr" id="counter">0</label>
                <button id="increaseButton">++</button>

                <img src="https://th.bing.com/th/id/OIP.rnKjS2Xf_dLh1eMipMTglQAAAA?rs=1&pid=ImgDetMain" alt="Quiejo">
                <label for="">Queijo Cheddar</label>
                
            </div>
        </div>
        <div class="footer">
            <div>Itens no carrinho: <span id="cart-count">0</span></div>
            <div>Preço Total: R$ <span id="total-price">0.00</span></div>
            <button class="button" onclick="checkout(); location.href='@Url.Action("Carrinho", "Home")'">
                Visualizar Pedido
            </button>
        </div>
    </div>
</div>


<script src="/js/Editar.js"></script>
