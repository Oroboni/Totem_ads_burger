@{
    ViewBag.Title = "Pedido";
    Layout = "~/Views/Shared/_WelcomeLayout.cshtml";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Totem_ads_burger</title>
    <link rel="stylesheet" href="~/css/pedido.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>


<div class="banner">
</div>

<div class="category-scrollbar">
    @if (ViewBag.Category != null)
    {
        @foreach (var subcategory in ViewBag.SubCategories)
        {
            string activeClass = subcategory.active ? "active" : "";
            <a href="/Pedido/@ViewBag.Category/@subcategory.id" class="subcategory-btn @activeClass">
                <span class="label">@subcategory.name</span>
            </a>
        }
    }
</div>

<div class="sidebar">
    @foreach (var category in ViewBag.Categories) // Itera sobre as categorias
    {
        string activeClass = category.active ? "active" : ""; // Define a classe "active" se a categoria estiver ativa
                                                              <a href="/Pedido/@category.id" class="category-btn @activeClass">
                                                                  <!-- Gera o link da categoria com a classe condicional -->
                                                                  <span class="icon">🍕</span>
                                                                  <span class="label">@category.name</span> <!-- Nome da categoria -->
                                                              </a>
    }
</div>

<!-- Conteúdo Principal -->
<div class="content" id="content">
    <div class="menu-grid">
        @foreach (var product in ViewBag.Products)
        {
            <div class="menu-item"
                onclick="showModal('@product.name', 'Descrição do produto @product.name', '@product.price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))', "https://via.placeholder.com/150")')">
                <img src=""https://via.placeholder.com/150")" alt="@product.name">
                <div class="options">
                    <h3>@product.name</h3>
                    <p>@(product.description ?? "Descrição não disponível")</p>
                    <strong class="price">@product.price.ToString("C",
                                            System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong>
            </div>
        </div>
                }
        <div class="end">
        </div>
    </div>
</div>

<div id="modal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal()">&times;</span>
        <img id="modal-img" src="" alt="Imagem do Produto"
            style="width:100%; border-radius:10px; margin-bottom:15px;" />
        <h2 id="titulo">Título</h2>
        <p id="descricao">Descrição</p>
        <p><strong id="preco">R$ 0,00</strong></p>

        <div class="quantity-control">
            <button onclick="changeQuantity(-1)">−</button>
            <span id="quantity">1</span>
            <button onclick="changeQuantity(1)">+</button>
        </div>

        <p><strong>Ingredientes:</strong> pão brioche, queijo cheddar derretido, hambúrguer de carne 100% bovina, bacon
            crocante, molho da casa.</p>

        <button id="add-button" onclick="addToCart()">Adicionar</button>
    </div>
</div>



<div class="footer">
    <div>Itens no carrinho: <span id="cart-count">0</span></div>
    <div>Preço Total: R$ <span id="total-price">0.00</span></div>
    <button class="button" onclick="checkout(); location.href='@Url.Action("Carrinho", "Home")'">Visualizar
        Pedido</button>
</div>