@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_WelcomeLayout.cshtml";
}
<style>
    html,
    body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(to right, #ff7e5f, #feb47b);
    }


    .card {
        background: white;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease-in-out;
    }

    .card:hover {
        transform: scale(1.05);
    }

    button {
        background: #ff6600;
        color: white;
        padding: 12px 20px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s ease-in-out;
    }

    button:hover {
        background: #e65c00;
    }


    .banner {
        width: 100%;
        height: 160px;
        background: linear-gradient(to right, #ff6600, #ff3300);
        color: white;
        background: url("https://as1.ftcdn.net/v2/jpg/11/83/61/00/1000_F_1183610030_iUhROCUzBuwVs6SkAk9um8cTY43gNUh8.jpg") center/cover;
        font-size: 2rem;
        font-weight: bold;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 2;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
    }

    .sidebar {
        width: 250px;
        background: white;
        padding: 20px;
        position: fixed;
        top: 160px;
        left: 0;
        height: calc(100vh - 160px);
        overflow-y: auto;
        box-shadow: 2px 0px 10px rgba(0, 0, 0, 0.1);
    }

    .sidebar ul {
        list-style: none;
        padding: 0;
    }

    .sidebar ul li {
        width: 100%;
        padding: 15px;
        margin: 10px 0;
        background: #fff;
        text-align: center;
        border-radius: 15px;
        transition: transform 0.3s ease-in-out, background 0.3s;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        cursor: pointer;
    }

    .sidebar ul li:hover {
        background: #ff9900;
        color: white;
        transform: scale(1.05);
    }

    .sidebar img {
        width: 150px;
        height: 100px;
        object-fit: contain;
    }

    .content {
        margin-left: 23%;
        margin-top: 180px;
        padding: 20px;
        width: calc(100% - 350px);
        flex: 1;
    }

    .menu-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        width: 100%;
        max-width: 1200px;
    }

    .menu-item {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        text-align: center;
        cursor: pointer;
        transition: transform 0.3s ease-in-out;
    }

    .menu-item:hover {
        transform: scale(1.05);
    }

    .menu-item img {
        width: 100%;
        height: 170px;
        object-fit: cover;
        border-radius: 10px;
    }

    .menu-item h3 {
        margin: 15px 0 10px;
        font-size: 22px;
        color: #333;
    }

    .menu-item p {
        font-size: 16px;
        color: #666;
    }

    .price {
        font-size: 18px;
        font-weight: bold;
        color: #ff3300;
    }

    .footer {
        width: 100%;
        background: white;
        padding: 15px;
        text-align: center;
        box-shadow: 0px -2px 5px rgba(0, 0, 0, 0.1);
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 2;
        font-size: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .footer button {
        background: #ff6600;
        color: white;
        font-size: 18px;
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
    }

    .footer button:hover {
        background: #cc4400;
    }

    /* Responsividade */
    @@media (max-width: 1024px) {
        .menu-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .menu-grid {
            grid-template-columns: repeat(1, 1fr);
        }

        .sidebar {
            width: 100%;
            position: relative;
            height: auto;
            box-shadow: none;
            top: auto;
            left: auto;
        }

        .content {
            margin-left: 0;
            margin-top: 0;
        }
    }
</style>

