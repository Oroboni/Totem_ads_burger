@{
    ViewBag.Title = "Pedido";
    Layout = "~/Views/Shared/_PedidoLayout.cshtml";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Totem_ads_burger</title>
    <link rel="stylesheet" href="~/css/pedido.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>


<div class="banner">
</div>

<div class="category-scrollbar">
    @if (ViewBag.Category != null)
    {
        <div class="filter-session">
            <div class="filter-label-vertical">
                <p>FILTROS</p>
            </div>
        </div>
        <div class="category-scrollbar">
        @foreach (var subcategory in ViewBag.SubCategories)
        {
            string activeClass = subcategory.active ? "active" : "";
            
                <div class="subcategory-item-card">
                    <div class="">
                        <img class="subcategory-image" src="/img/IcedCola.png"
                            alt="">
                    </div>
                    <a class="subcategory-name-label" href="/Pedido/@ViewBag.Category/@subcategory.id"
                        class="subcategory-item-card.active @activeClass">
                        <span class="label">@subcategory.name</span>
                    </a>
                </div>
            
        }
        </div>
    }
</div>

<div class="sidebar">
    @foreach (var category in ViewBag.Categories)
    {
        string activeClass = category.active ? "active" : "";
        <a href="/Pedido/@category.id" class="category-btn @activeClass">

            <span class="icon">
                <img src="~/img/lanche.png"
                    alt="Descrição da imagem" class="category-icon-img" width="100" height="100">
            </span>
            <span class="label">@category.name</span>
        </a>
    }
    <div class="end"></div>
</div>


<!-- Conteúdo Principal -->
<div class="content" id="content">
    <div class="menu-grid">
        @foreach (var product in ViewBag.Products)
        {
            var priceStr = product.price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
            var imageUrl =
            "/img/burguer.png";
            @* "~/img/" + (product.image ?? "default.png");  Usa a imagem padrão se não houver imagem *@
            <div class="menu-item"
                onclick="showModal('@product.name', '@(product.description ?? "Descrição não disponível")', '@priceStr', '@imageUrl')">
                <div class="rectangle-background">
                    <img class="image-background" src="@imageUrl" alt="@product.name" />
                </div>
                <div class="options">
                    <h3 class="product-name">@product.name</h3>
                    <strong class="price">@priceStr</strong>
                    <p>@(product.description ?? "Descrição não disponível")</p>
                </div>
            </div>
        }

        <div class="end">
        </div>
    </div>
</div>

<div id="modal" class="modal">
    <div class="modal-content">
        <!-- Botão de fechar -->
        <button type="button" class="modal-close-btn" onclick="closeModal()">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        <!-- Imagem do produto -->
        <div class="modal-image-container">
            <img id="modal-img" src="https://via.placeholder.com/150x100/CCCCCC/808080?text=Produto"
                alt="Imagem do Produto" />
        </div>

        <!-- Título do produto -->
        <h2 id="titulo" class="modal-product-title">Título do Produto</h2>

        <!-- Preço calculado -->
        <p id="preco" class="modal-product-price">R$ 0,00</p>

        <!-- Preço maior/menor no modal -->
        <div class="quantity-control modal-quantity-selector">
            <button type="button" class="quantity-btn minus-btn" onclick="changeQuantity(-1)">−</button>
            <span id="quantity" class="quantity-display">1</span>
            <button type="button" class="quantity-btn plus-btn" onclick="changeQuantity(1)">+</button>
        </div>

        <!-- Ingredientes -->
        <div class="modal-ingredients-section">
            <h3 class="modal-ingredients-title">Ingredientes:</h3>
            <p id="descricao" class="modal-ingredients-list">Descrição dos ingredientes aqui...</p>
        </div>

        <!-- add-button amount carrinho -->
        <button type="button" id="add-button" class="modal-add-button" onclick="addToCart()">Adicionar</button>
    </div>
</div>

<div class="footer">
    <div class="footer-summary">
        <div>Total de itens: <span id="cart-count">0</span></div>
        <div>Total do pedido: <span class="currency-symbol">R$</span> <span id="total-price">0.00</span></div>
    </div>
    <button class="button" onclick="checkout(); location.href='@Url.Action("Carrinho", "Home")'">Visualizar
        Pedido!</button>
</div>

<script>
    let cartCount = 0;
    let totalPrice = 0;

    function changeQuantity(amount) {
        const quantityElement = document.getElementById("quantity");
        let currentQuantity = parseInt(quantityElement.innerText);
        currentQuantity = Math.max(1, currentQuantity + amount);
        quantityElement.innerText = currentQuantity;
    }

    function addToCart() {
        let price = parseFloat(document.getElementById("preco").innerText.replace('R$', '').replace(',', '.'));
        cartCount++;
        const quantity = parseInt(document.getElementById("quantity").innerText);
        totalPrice += price * quantity;
        document.getElementById("cart-count").innerText = cartCount;
        document.getElementById("total-price").innerText = totalPrice.toFixed(2);
        closeModal();
    }

    function checkout() {
        @* alert("Pedido finalizado! Total: R$ " + totalPrice.toFixed(2));
        cartCount = 0;
        totalPrice = 0;
        document.getElementById("cart-count").innerText = cartCount;
        document.getElementById("total-price").innerText = totalPrice.toFixed(2); *@
    }

    function showModal(title, description, preco, imageUrl) {
        document.getElementById('titulo').innerText = title;
        document.getElementById('descricao').innerText = description;
        document.getElementById('preco').innerText = preco;
        document.getElementById('modal-img').src = imageUrl;
        document.getElementById('quantity').innerText = 1;
        document.getElementById('modal').style.display = 'block';
    }


    function closeModal() {
        document.getElementById('modal').style.display = 'none';
    }

    window.onclick = function (event) {
        var modal = document.getElementById('modal');
        if (event.target === modal) {
            modal.style.display = 'none';
        }
    }
</script>