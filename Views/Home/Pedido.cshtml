@{
    ViewBag.Title = "Pedido";
    Layout = "~/Views/Shared/_WelcomeLayout.cshtml";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Totem_ads_burger</title>
    <link rel="stylesheet" href="~/css/pedido.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>


<div class="banner">
</div>

<div class="category-scrollbar">
    @if (ViewBag.Category != null)
    {
        @foreach (var subcategory in ViewBag.SubCategories)
        {
            string activeClass = subcategory.active ? "active" : "";
            <a href="/Pedido/@ViewBag.Category/@subcategory.id" class="subcategory-btn @activeClass">
                <span class="label">@subcategory.name</span>
            </a>
        }
    }
</div>

<div class="sidebar">
    @foreach (var category in ViewBag.Categories) // Itera sobre as categorias
    {
        string activeClass = category.active ? "active" : ""; // Define a classe "active" se a categoria estiver ativa
                                                              <a href="/Pedido/@category.id" class="category-btn @activeClass">
                                                                  <!-- Gera o link da categoria com a classe condicional -->
                                                                  <span class="icon">🍕</span>
                                                                  <span class="label">@category.name</span> <!-- Nome da categoria -->
                                                              </a>
    }
    <div class="end"></div>
</div>

<!-- Conteúdo Principal -->
<div class="content" id="content">
    <div class="menu-grid">
        @foreach (var product in ViewBag.Products)
        {
            var priceStr = product.price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
            var imageUrl =
            "https://static.itdg.com.br/images/640-440/49687a8a7a7110c7f560b9c7e96a9d0e/254679-shutterstock-364110890-1-.jpg";

            <div class="menu-item"
                onclick="showModal('@product.name', '@(product.description ?? "Descrição não disponível")', '@priceStr', '@imageUrl')">
                <img src="@imageUrl" alt="@product.name" />
                <div class="options">
                    <h3>@product.name</h3>
                    <p>@(product.description ?? "Descrição não disponível")</p>
                    <strong class="price">@priceStr</strong>
                </div>
            </div>
        }

        <div class="end">
        </div>
    </div>
</div>

<div id="modal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal()">&times;</span>
        <img id="modal-img" src="" alt="Imagem do Produto"
            style="width:100%; border-radius:10px; margin-bottom:15px;" />
        <h2 id="titulo">Título</h2>
        <p id="descricao">Descrição</p>
        <p><strong id="preco">R$ 0,00</strong></p>

        <div class="quantity-control">
            <button onclick="changeQuantity(-1)">−</button>
            <span id="quantity">1</span>
            <button onclick="changeQuantity(1)">+</button>
        </div>

        <p><strong>Ingredientes:</strong> pão brioche, queijo cheddar derretido, hambúrguer de carne 100% bovina, bacon
            crocante, molho da casa.</p>

        <button id="add-button" onclick="addToCart()">Adicionar</button>
    </div>
</div>



<div class="footer">
    <div>Itens no carrinho: <span id="cart-count">0</span></div>
    <div>Preço Total: R$ <span id="total-price">0.00</span></div>
    <button class="button" onclick="checkout(); location.href='@Url.Action("Carrinho", "Home")'">Visualizar
        Pedido</button>
</div>

<script>
    let cartCount = 0;
    let totalPrice = 0;

    function changeQuantity(amount) {
        const quantityElement = document.getElementById("quantity");
        let currentQuantity = parseInt(quantityElement.innerText);
        currentQuantity = Math.max(1, currentQuantity + amount);
        quantityElement.innerText = currentQuantity;
    }

    function addToCart() {
        let price = parseFloat(document.getElementById("preco").innerText.replace('R$', '').replace(',', '.'));
        cartCount++;
        const quantity = parseInt(document.getElementById("quantity").innerText);
        totalPrice += price * quantity;
        document.getElementById("cart-count").innerText = cartCount;
        document.getElementById("total-price").innerText = totalPrice.toFixed(2);
        closeModal();
    }

    function checkout() {
        @* alert("Pedido finalizado! Total: R$ " + totalPrice.toFixed(2));
        cartCount = 0;
        totalPrice = 0;
        document.getElementById("cart-count").innerText = cartCount;
        document.getElementById("total-price").innerText = totalPrice.toFixed(2); *@
    }

    function showModal(title, description, preco, imageUrl) {
        document.getElementById('titulo').innerText = title;
        document.getElementById('descricao').innerText = description;
        document.getElementById('preco').innerText = preco;
        document.getElementById('modal-img').src = imageUrl;
        document.getElementById('quantity').innerText = 1;
        document.getElementById('modal').style.display = 'block';
    }


    function closeModal() {
        document.getElementById('modal').style.display = 'none';
    }

    window.onclick = function (event) {
        var modal = document.getElementById('modal');
        if (event.target === modal) {
            modal.style.display = 'none';
        }
    }
</script>