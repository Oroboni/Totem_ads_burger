@{
    ViewBag.Title = "Carrinho";
    Layout = "~/Views/Shared/_CarrinhoLayout.cshtml";
    @model EditarViewModel
}

<link rel="stylesheet" href="~/css/Editar.css">
<div class="banner"></div>

<div class="content">

    <div class="container mt-5">

        <div class="content" style="display: flex; align-items: center; justify-content: center;">
            <a onclick="voltar()" class="buttonVoltar btn-left">
                <i class="fa-solid fa-arrow-left" style="color: #ffffff;"></i>
                Voltar
            </a>
            <div style="display: flex; align-items: center; justify-content: center;">
                <h1 class="fotoHamburger" id="nome">Looping Duplo</h1>
            </div>

            @if (Model.Product != null)
            {
                @if (Model.Product.Compositions != null)
                {
                    <div style="align-content: flex-start; justify-content: flex-start;">
                        <h1 style="margin-left: 30px; font-size: 30px; text-align: left;">Ingredientes: </h1>
                    </div>
                    @foreach (var comp in Model.Product.Compositions)
                    {
                        if (comp.Ingredient == null)
                        {
                            continue;
                        }
                        <div class="contentIngredient ingrediente-@comp.Ingredient.Id">
                            <button class="editarButton decreseButton" data-ingredient-id="@comp.Ingredient.Id"
                                data-pedido-id="@Model.Product.Id">
                                <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" viewBox="0 0 70 70"
                                    object-fit="contain">
                                    <path
                                        d="M34.9997 5.8335C18.9288 5.8335 5.83301 18.9293 5.83301 35.0002C5.83301 51.071 18.9288 64.1668 34.9997 64.1668C51.0705 64.1668 64.1663 51.071 64.1663 35.0002C64.1663 18.9293 51.0705 5.8335 34.9997 5.8335ZM46.433 37.1877H23.0997C21.9038 37.1877 20.9122 36.196 20.9122 35.0002C20.9122 33.8043 21.9038 32.8127 23.0997 32.8127H46.433C47.6288 32.8127 48.6205 33.8043 48.6205 35.0002C48.6205 36.196 47.658 37.1877 46.433 37.1877Z"
                                        fill="#463B3B" />
                                </svg>
                            </button>
                            <span class="labelNmr" id="fiz" data-ingredient-id="@comp.Ingredient.Id"
                                data-pedido-id="@(Model.Product?.Id ?? Model.Combo?.Id)">
                                @comp.quantity
                            </span>

                            <button class="editarButton increaseButton" data-ingredient-id="@comp.Ingredient.Id"
                                data-pedido-id="@Model.Product.Id">
                                <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" viewBox="0 0 70 70"
                                    object-fit="contain">
                                    <path
                                        d="M35.0002 5.83325C18.9293 5.83325 5.8335 18.9291 5.8335 34.9999C5.8335 51.0708 18.9293 64.1666 35.0002 64.1666C51.071 64.1666 64.1668 51.0708 64.1668 34.9999C64.1668 18.9291 51.071 5.83325 35.0002 5.83325ZM46.6668 37.1874H37.1877V46.6666C37.1877 47.8624 36.196 48.8541 35.0002 48.8541C33.8043 48.8541 32.8127 47.8624 32.8127 46.6666V37.1874H23.3335C22.1377 37.1874 21.146 36.1958 21.146 34.9999C21.146 33.8041 22.1377 32.8124 23.3335 32.8124H32.8127V23.3333C32.8127 22.1374 33.8043 21.1458 35.0002 21.1458C36.196 21.1458 37.1877 22.1374 37.1877 23.3333V32.8124H46.6668C47.8627 32.8124 48.8543 33.8041 48.8543 34.9999C48.8543 36.1958 47.8627 37.1874 46.6668 37.1874Z"
                                        fill="#463B3B" />
                                </svg>
                            </button>
                            <img class="fotoIngrediente" src="@comp.Ingredient.Foto" alt="@comp.Ingredient.Name" />
                            <h2>@comp.Ingredient.Name</h2>
                            <span class="price" style="display: none;">R$ @comp.Ingredient.AdditionalPrice.ToString("0.00")</span>
                        </div>
                    }
                }
            }
            else if (Model.Combo != null && Model.Combo.ComboProducts != null)
            {
                int productIndex = 0;
                @foreach (var cp in Model.Combo.ComboProducts)
                {
                    if (cp?.Product?.Compositions == null) { continue; }

                    @if (cp.Product.Compositions.Count != 0)
                    {
                        <h2 class="lanche-nome" data-product-index="@productIndex">@cp.Product.Name</h2>
                        <div style="align-content: flex-start; justify-content: flex-start;">
                            <h2 style="margin-left: 30px; font-size: 30px; text-align: left;">Ingredientes: </h2>
                        </div>
                    }

                    @foreach (var comp in cp.Product.Compositions)
                    {
                        if (comp?.Ingredient == null) { continue; }

                        <div class="contentIngredient ingrediente-@comp.Ingredient.Id-product-@productIndex">
                            <button class="editarButton decreseButton" data-ingredient-id="@comp.Ingredient.Id"
                                data-product-index="@productIndex" data-pedido-id="@Model.Combo.Id">
                                <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" viewBox="0 0 70 70"
                                    object-fit="contain">
                                    <path
                                        d="M34.9997 5.8335C18.9288 5.8335 5.83301 18.9293 5.83301 35.0002C5.83301 51.071 18.9288 64.1668 34.9997 64.1668C51.0705 64.1668 64.1663 51.071 64.1663 35.0002C64.1663 18.9293 51.0705 5.8335 34.9997 5.8335ZM46.433 37.1877H23.0997C21.9038 37.1877 20.9122 36.196 20.9122 35.0002C20.9122 33.8043 21.9038 32.8127 23.0997 32.8127H46.433C47.6288 32.8127 48.6205 33.8043 48.6205 35.0002C48.6205 36.196 47.658 37.1877 46.433 37.1877Z"
                                        fill="#463B3B" />
                                </svg>
                            </button>
                            <span class="labelNmr" data-ingredient-id="@comp.Ingredient.Id" data-product-index="@productIndex"
                                data-pedido-id="@Model.Combo?.Id">
                                @comp.quantity
                            </span>
                            <button class="editarButton increaseButton" data-ingredient-id="@comp.Ingredient.Id"
                                data-product-index="@productIndex" data-pedido-id="@Model.Combo.Id">
                                <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" viewBox="0 0 70 70"
                                    object-fit="contain">
                                    <path
                                        d="M35.0002 5.83325C18.9293 5.83325 5.8335 18.9291 5.8335 34.9999C5.8335 51.0708 18.9293 64.1666 35.0002 64.1666C51.071 64.1666 64.1668 51.0708 64.1668 34.9999C64.1668 18.9291 51.071 5.83325 35.0002 5.83325ZM46.6668 37.1874H37.1877V46.6666C37.1877 47.8624 36.196 48.8541 35.0002 48.8541C33.8043 48.8541 32.8127 47.8624 32.8127 46.6666V37.1874H23.3335C22.1377 37.1874 21.146 36.1958 21.146 34.9999C21.146 33.8041 22.1377 32.8124 23.3335 32.8124H32.8127V23.3333C32.8127 22.1374 33.8043 21.1458 35.0002 21.1458C36.196 21.1458 37.1877 22.1374 37.1877 23.3333V32.8124H46.6668C47.8627 32.8124 48.8543 33.8041 48.8543 34.9999C48.8543 36.1958 47.8627 37.1874 46.6668 37.1874Z"
                                        fill="#463B3B" />
                                </svg>
                            </button>

                            <img class="fotoIngrediente" src="@comp.Ingredient.Foto" alt="@comp.Ingredient.Name" />
                            <h2>@comp.Ingredient.Name</h2>
                            <span class="price" style="display: none;">
                                R$ @comp.Ingredient.AdditionalPrice.ToString("0.00")
                            </span>
                        </div>
                    }
                    productIndex++;
                }
            }


            <div style="margin-bottom: 117px;"></div>
        </div>
    </div>

    <div class="footer">
        <div>
            <div class="editarButtonFooter" style="display: flex; align-items: center;">
                <button class="editarButtonFooter" onclick="adjustQty(-1)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="33" height="33" viewBox="0 0 70 70"
                        object-fit="contain">
                        <path
                            d="M34.9997 5.8335C18.9288 5.8335 5.83301 18.9293 5.83301 35.0002C5.83301 51.071 18.9288 64.1668 34.9997 64.1668C51.0705 64.1668 64.1663 51.071 64.1663 35.0002C64.1663 18.9293 51.0705 5.8335 34.9997 5.8335ZM46.433 37.1877H23.0997C21.9038 37.1877 20.9122 36.196 20.9122 35.0002C20.9122 33.8043 21.9038 32.8127 23.0997 32.8127H46.433C47.6288 32.8127 48.6205 33.8043 48.6205 35.0002C48.6205 36.196 47.658 37.1877 46.433 37.1877Z"
                            fill="#463B3B" />
                    </svg>
                </button>
                <span class="labelNmrFooter" id="counter" name="counter">1</span>
                <button class="editarButtonFooter" onclick="adjustQty(+1)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="33" height="33" viewBox="0 0 70 70"
                        object-fit="contain">
                        <path
                            d="M35.0002 5.83325C18.9293 5.83325 5.8335 18.9291 5.8335 34.9999C5.8335 51.0708 18.9293 64.1666 35.0002 64.1666C51.071 64.1666 64.1668 51.0708 64.1668 34.9999C64.1668 18.9291 51.071 5.83325 35.0002 5.83325ZM46.6668 37.1874H37.1877V46.6666C37.1877 47.8624 36.196 48.8541 35.0002 48.8541C33.8043 48.8541 32.8127 47.8624 32.8127 46.6666V37.1874H23.3335C22.1377 37.1874 21.146 36.1958 21.146 34.9999C21.146 33.8041 22.1377 32.8124 23.3335 32.8124H32.8127V23.3333C32.8127 22.1374 33.8043 21.1458 35.0002 21.1458C36.196 21.1458 37.1877 22.1374 37.1877 23.3333V32.8124H46.6668C47.8627 32.8124 48.8543 33.8041 48.8543 34.9999C48.8543 36.1958 47.8627 37.1874 46.6668 37.1874Z"
                            fill="#463B3B" />
                    </svg>
                </button>
            </div>
            <span>Quantidade</span>
        </div>
        <div>Preço Total: R$ <span id="total-price">0.00</span></div>
        <div style="align-items: center; padding-bottom: 5px;">
            <div class="ftr2"><button class="ftr2" onclick="voltar();">Cancelar</button></div>
            <button class=" button"
                onclick="salvarIngredientes('@(Model.Product?.Id ?? Model.Combo?.Id)');location.href='@Url.Action("Carrinho", "Cart")'">Confirmar</button>
        </div>
        <span style="display: none;" id="pedido-id">@(Model.Product?.Id ?? Model.Combo?.Id)</span>
    </div>

    <script src="/js/Editar.js"></script>
    <script>
        window.addEventListener("DOMContentLoaded", load);
        window.addEventListener("DOMContentLoaded", amount);
        let pedidoTemporario = null;

        function amount() {
            const savedCart = localStorage.getItem("cart");
            const selectedPedidoId = localStorage.getItem("idpedidoSelecionado");

            const cart = JSON.parse(savedCart);
            const pedido = cart.find(p => p.idpedido == selectedPedidoId);

            // Para produtos únicos
            if (Array.isArray(pedido.ingredients)) {
                pedido.ingredients.forEach(ing => {
                    const span = document.querySelector(`.labelNmr[data-ingredient-id="${ing.id.toString()}"]`);
                    if (span) {
                        span.innerText = ing.quantity;
                    }
                });
            }

            // Para combos - ingredientes separados por produto
            if (Array.isArray(pedido.comboIngredients)) {
                pedido.comboIngredients.forEach(productIngredients => {
                    if (Array.isArray(productIngredients.ingredients)) {
                        productIngredients.ingredients.forEach(ing => {
                            const span = document.querySelector(`.labelNmr[data-ingredient-id="${ing.id.toString()}"][data-product-index="${productIngredients.productIndex}"]`);
                            if (span) {
                                span.innerText = ing.quantity;
                            }
                        });
                    }
                });
            }
        }

        function load() {
            const savedCart = localStorage.getItem("cart");
            const selectedPedidoId = localStorage.getItem("idpedidoSelecionado");

            const cart = JSON.parse(savedCart);
            const pedido = cart.find(p => p.idpedido == selectedPedidoId);

            // Inicializar ingredientes para produtos únicos
            if (!Array.isArray(pedido.ingredients) && !Array.isArray(pedido.comboIngredients)) {
                pedido.ingredients = [];
                const spans = document.querySelectorAll('.labelNmr[data-ingredient-id]:not([data-product-index])');
                spans.forEach(span => {
                    const ingredientId = parseInt(span.dataset.ingredientId);
                    const currentQuantity = parseInt(span.innerText) || 1;
                    pedido.ingredients.push({
                        id: ingredientId,
                        quantity: currentQuantity
                    });
                });
            }

            // Inicializar ingredientes para combos
            if (!Array.isArray(pedido.comboIngredients)) {
                pedido.comboIngredients = [];
                const productIndices = new Set();

                // Descobrir quantos produtos diferentes temos
                document.querySelectorAll('.labelNmr[data-product-index]').forEach(span => {
                    productIndices.add(parseInt(span.dataset.productIndex));
                });


                // Criar estrutura para cada produto do combo
                productIndices.forEach(productIndex => {
                    const lancheNameSpan = document.querySelector(`.lanche-nome[data-product-index="${productIndex}"]`);
                    const lancheName = lancheNameSpan ? lancheNameSpan.innerText.trim() : `Lanche ${productIndex}`;
                    const productIngredients = {
                        productIndex: productIndex,
                        ingredients: [],
                        Lanche: lancheName
                    };

                    const spans = document.querySelectorAll(`.labelNmr[data-product-index="${productIndex}"]`);
                    spans.forEach(span => {
                        const ingredientId = parseInt(span.dataset.ingredientId);
                        const currentQuantity = parseInt(span.innerText) || 1;
                        productIngredients.ingredients.push({
                            id: ingredientId,
                            quantity: currentQuantity,
                            additionalPrice: findIngredientPrice(ingredientId, productIndex)
                        });
                    });

                    pedido.comboIngredients.push(productIngredients);
                });
            }

            console.log(cart);

            const counter = document.getElementById("counter");
            const price = document.getElementById("total-price");

            if (counter) counter.innerText = pedido.quantity || 1;
            if (price) price.innerText = pedido.totalItemPrice || "0.00";
            document.getElementById("nome").innerText = pedido.name || "Produto";

            pedido.unitBasePrice = parseFloat(pedido.totalItemPrice) / (pedido.quantity || 1);
            pedidoTemporario = JSON.parse(JSON.stringify(pedido));
        }

        function adjustQty(amount) {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            const idpedido = localStorage.getItem("idpedidoSelecionado");
            const item = cart.find(item => item.idpedido === idpedido);

            if (item) {
                const unitPrice = parseFloat(item.totalItemPrice) / item.quantity;
                item.quantity = Math.max(1, item.quantity + amount);
                item.totalItemPrice = (unitPrice * item.quantity).toFixed(2);
                localStorage.setItem("cart", JSON.stringify(cart));
            }

            load();
        }

        function adjustIngredientQty(ingredientId, amount, productIndex = null) {
            if (!pedidoTemporario) return;

            let ingredient;
            let currentQuantity = 0;

            // Para combos
            if (productIndex !== null && Array.isArray(pedidoTemporario.comboIngredients)) {
                let productIngredients = pedidoTemporario.comboIngredients.find(p => p.productIndex === productIndex);

                if (!productIngredients) {
                    productIngredients = { productIndex: productIndex, ingredients: [] };
                    pedidoTemporario.comboIngredients.push(productIngredients);
                }

                ingredient = productIngredients.ingredients.find(i => parseInt(i.id) === parseInt(ingredientId));
                const span = document.querySelector(`.labelNmr[data-ingredient-id="${ingredientId}"][data-product-index="${productIndex}"]`);
                currentQuantity = span ? parseInt(span.innerText) || 0 : 0;
                const newQuantity = Math.max(0, currentQuantity + amount);

                if (!ingredient) {
                    ingredient = {
                        id: ingredientId,
                        quantity: newQuantity,
                        additionalPrice: findIngredientPrice(ingredientId, productIndex)
                    };
                    productIngredients.ingredients.push(ingredient);
                } else {
                    ingredient.quantity = newQuantity;
                    if (typeof ingredient.additionalPrice === "undefined") {
                        ingredient.additionalPrice = findIngredientPrice(ingredientId, productIndex);
                    }
                }

                if (span) span.innerText = ingredient.quantity;
            }
            // Para produtos únicos
            else {
                ingredient = pedidoTemporario.ingredients.find(i => parseInt(i.id) === parseInt(ingredientId));
                const span = document.querySelector(`.labelNmr[data-ingredient-id="${ingredientId}"]:not([data-product-index])`);
                currentQuantity = span ? parseInt(span.innerText) || 0 : 0;
                const newQuantity = Math.max(0, currentQuantity + amount);

                if (!ingredient) {
                    ingredient = {
                        id: ingredientId,
                        quantity: newQuantity,
                        additionalPrice: findIngredientPrice(ingredientId)
                    };
                    pedidoTemporario.ingredients.push(ingredient);
                } else {
                    ingredient.quantity = newQuantity;
                    if (typeof ingredient.additionalPrice === "undefined") {
                        ingredient.additionalPrice = findIngredientPrice(ingredientId);
                    }
                }

                if (span) span.innerText = ingredient.quantity;
            }

            recalculateTotalPrice(pedidoTemporario);
        }

        function recalculateTotalPrice(pedido) {
            let baseTotal = 0;

            // Calcular preço dos ingredientes de produtos únicos
            if (Array.isArray(pedido.ingredients)) {
                pedido.ingredients.forEach(ing => {
                    baseTotal += ing.quantity * (ing.additionalPrice || 0);
                });
            }

            // Calcular preço dos ingredientes de combos
            if (Array.isArray(pedido.comboIngredients)) {
                pedido.comboIngredients.forEach(productIngredients => {
                    if (Array.isArray(productIngredients.ingredients)) {
                        productIngredients.ingredients.forEach(ing => {
                            baseTotal += ing.quantity * (ing.additionalPrice || 0);
                        });
                    }
                });
            }

            const total = (parseFloat(pedido.precobase || 0) + baseTotal) * (pedido.quantity || 1);
            document.getElementById("total-price").innerText = total.toFixed(2);
        }

        function salvarIngredientes(id) {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            const index = cart.findIndex(p => p.idpedido === pedidoTemporario.idpedido);
            if (index === -1) return;

            let baseTotal = 0;

            // Calcular total dos ingredientes de produtos únicos
            if (Array.isArray(pedidoTemporario.ingredients)) {
                pedidoTemporario.ingredients.forEach(ing => {
                    baseTotal += ing.quantity * (ing.additionalPrice || 0);
                });
            }

            // Calcular total dos ingredientes de combos
            if (Array.isArray(pedidoTemporario.comboIngredients)) {
                pedidoTemporario.comboIngredients.forEach(productIngredients => {
                    if (Array.isArray(productIngredients.ingredients)) {
                        productIngredients.ingredients.forEach(ing => {
                            baseTotal += ing.quantity * (ing.additionalPrice || 0);
                        });
                    }
                });
            }

            const unitBase = pedidoTemporario.precobase || 0;
            const quantidade = pedidoTemporario.quantity || 1;
            const total = ((parseFloat(unitBase) + baseTotal) * quantidade).toFixed(2);

            pedidoTemporario.totalItemPrice = total;

            cart[index] = pedidoTemporario;
            localStorage.setItem("cart", JSON.stringify(cart));
        }

        function findIngredientPrice(ingredientId, productIndex = null) {
            let selector;
            if (productIndex !== null) {
                selector = `.ingrediente-${ingredientId}-product-${productIndex}`;
            } else {
                selector = `.ingrediente-${ingredientId}`;
            }

            const el = document.querySelector(selector);
            if (!el) return 0;
            const priceText = el.querySelector("span.price")?.innerText;
            return priceText ? parseFloat(priceText.replace("R$", "").replace(",", ".")) : 0;
        }

        // Event listeners para botões de aumento
        document.querySelectorAll(".increaseButton").forEach(button => {
            button.addEventListener("click", () => {
                const iid = parseInt(button.dataset.ingredientId);
                const productIndex = button.dataset.productIndex ? parseInt(button.dataset.productIndex) : null;
                adjustIngredientQty(iid, 1, productIndex);
            });
        });

        // Event listeners para botões de redução
        document.querySelectorAll(".decreseButton").forEach(button => {
            button.addEventListener("click", () => {
                const iid = parseInt(button.dataset.ingredientId);
                const productIndex = button.dataset.productIndex ? parseInt(button.dataset.productIndex) : null;
                adjustIngredientQty(iid, -1, productIndex);
            });
        });

    </script>