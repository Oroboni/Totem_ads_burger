@{
    ViewBag.Title = "Carrinho";
    Layout = "~/Views/Shared/_CarrinhoLayout.cshtml";

}

<head>
    <link rel="stylesheet" href="~/css/carrinho.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

</head>


<div class="coupon-bar">
    <a onclick="location.href='@Url.Action("Pedido", "Home")'" class="button btn-left">
        <i class="fa-solid fa-arrow-left" style="color: #ffffff;"></i> Voltar</a>
    <a href="/Home/Pedido" class="button btn-right"><i class="fa-solid fa-ticket" style="color: #ffffff;"></i> INSIRA
        AQUI SEU CUPOM!</a>
</div>

<div class="content">
    @* <section class="section"> *@

    @* </section> *@
    @* <section class="section"> *@

    @* </section> *@
</div>

<div class="bottom-bar">
    <div class="total-info">
        <div>Itens no carrinho: <span id="cart-count">0</span></div>
        <div>Preço Total: R$ <span id="total-price">0.00</span></div>
    </div>
    <div class="bottom-buttons">
        <button class="cancel-button" onclick="cancel()">Cancelar pedido</button>
        <button class="confirm-button" onclick="location.href='@Url.Action("EscolherLocal", "Home")'">Confirmar pedido</button>
    </div>
</div>

<script src="~/js/editar.js"></script>
<script>
    const produtosComIngredientes = @Html.Raw(Json.Serialize(ViewBag.IdsComIngredientes));
    function load() {
        const savedCart = localStorage.getItem("cart");
        if (!savedCart) return;
        const cart = JSON.parse(savedCart);
        let cartCount = cart.length;
        let totalPrice = cart.reduce((sum, item) => sum + parseFloat(item.totalItemPrice), 0);

        document.getElementById("cart-count").innerText = cartCount;
        document.getElementById("total-price").innerText = totalPrice.toFixed(2);

        const contentDiv = document.querySelector(".content");
        contentDiv.innerHTML = '<h2 id="title1"></h2>';

        cart.forEach((item) => {
            const card = document.createElement("div");
            card.className = "card";
            card.innerHTML = `
                <div class="card-details">
                    <div class="burguer-bar">
                        <p class="text-title">${item.name || "Produto"}</p>
                        <div class="burguer-barTrash">
                            <button onclick="removerItem('${item.idpedido}')" style="background: none; border: none; cursor: pointer;">
                                <img src="/img/icons/trash-can.svg" alt="Remover">
                            </button>
                        </div>
                    </div>
                    <div class="burguer-bar">
                        <img class="img-card" src="/img/${item.imageUrl || "default-product.png"}" alt="${item.name || "Produto"}">
                        <p class="text-body">${item.description || "Descrição não disponível"}</p>
                    </div>
                    
                    <div class="burguer-bar-footer">
                        <span class="labelNmr">R$${parseFloat(item.totalItemPrice).toFixed(2)}</span>
                        ${produtosComIngredientes.includes(parseInt(item.id)) ? `
                            <button class="burguer-bar-footer-button"
                                onclick="salvarEPersonalizar('${item.id}', '${item.idpedido}')">Personalizar Pedido</button>
                        ` : ''}

                        <div class="burguer-bar-buttonQtde">
                            <button class="editarButton" onclick="adjustQty('${item.idpedido}', -1)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 70 70">
                                    <path d="M34.9997 5.8335C18.9288 5.8335 5.83301 18.9293 5.83301 35.0002C5.83301 51.071 18.9288 64.1668 34.9997 64.1668C51.0705 64.1668 64.1663 51.071 64.1663 35.0002C64.1663 18.9293 51.0705 5.8335 34.9997 5.8335ZM46.433 37.1877H23.0997C21.9038 37.1877 20.9122 36.196 20.9122 35.0002C20.9122 33.8043 21.9038 32.8127 23.0997 32.8127H46.433C47.6288 32.8127 48.6205 33.8043 48.6205 35.0002C48.6205 36.196 47.658 37.1877 46.433 37.1877Z" fill="#463B3B"/>
                                </svg>
                            </button>
                            <span class="labelNmr">${item.quantity}</span>
                            <button onclick="adjustQty('${item.idpedido}', 1)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 70 70">
                                    <path d="M35.0002 5.83325C18.9293 5.83325 5.8335 18.9291 5.8335 34.9999C5.8335 51.0708 18.9293 64.1666 35.0002 64.1666C51.071 64.1666 64.1668 51.0708 64.1668 34.9999C64.1668 18.9291 51.071 5.83325 35.0002 5.83325ZM46.6668 37.1874H37.1877V46.6666C37.1877 47.8624 36.196 48.8541 35.0002 48.8541C33.8043 48.8541 32.8127 47.8624 32.8127 46.6666V37.1874H23.3335C22.1377 37.1874 21.146 36.1958 21.146 34.9999C21.146 33.8041 22.1377 32.8124 23.3335 32.8124H32.8127V23.3333C32.8127 22.1374 33.8043 21.1458 35.0002 21.1458C36.196 21.1458 37.1877 22.1374 37.1877 23.3333V32.8124H46.6668C47.8627 32.8124 48.8543 33.8041 48.8543 34.9999C48.8543 36.1958 47.8627 37.1874 46.6668 37.1874Z" fill="#463B3B"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            `;
            contentDiv.appendChild(card);
        });
    }

    function cancel() {
        localStorage.removeItem("cart");
        history.back();
    }

    function removerItem(idpedido) {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        const updatedCart = cart.filter(item => item.idpedido !== idpedido);
        localStorage.setItem("cart", JSON.stringify(updatedCart));
        load();
        alert("Item removido com sucesso!");
    }

    function salvarEPersonalizar(id, idpedido) {
        localStorage.setItem("idpedidoSelecionado", idpedido);
        location.href = `/Cart/Editar?id=${id}`;
    }

    function adjustQty(idpedido, amount) {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        const item = cart.find(item => item.idpedido === idpedido);

        if (item) {
            // Calcular preço unitário baseado no total atual dividido pela quantidade atual
            const unitPrice = parseFloat(item.totalItemPrice) / item.quantity;

            // Atualizar a quantidade, com no mínimo 1
            item.quantity = Math.max(1, item.quantity + amount);

            // Atualizar o preço total do item
            item.totalItemPrice = (unitPrice * item.quantity).toFixed(2);

            // Salvar o novo estado do carrinho
            localStorage.setItem("cart", JSON.stringify(cart));
        }

        load(); // Recarrega o HTML dinamicamente
        if (amount < 1) {
            removerItem(idpedido);
            return;
        }
    }


    window.onload = load;
</script>