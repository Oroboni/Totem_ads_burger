@{
    ViewBag.Title = "Carrinho";
    Layout = "~/Views/Shared/_CarrinhoLayout.cshtml";

}

<head>
    <link rel="stylesheet" href="~/css/carrinho.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

        <style>
                .footer {
            width: 100%;
            background: white;
            padding: 12px 25px;
            text-align: left; /* Embora o flexbox controle o alinhamento principal, é bom manter */
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 998;
            font-size: 1rem; /* Tamanho base da fonte no footer */
            display: flex;
            justify-content: space-between; /* Coloca .footer-summary à esquerda e .button à direita */
            align-items: center;
            min-height: 70px;
            color: #1E1E1E; /* Cor padrão do texto*/
        }

        .footer-summary > div {
            /* Estilo para cada linha de texto: "Total de itens..." e "Total do pedido..." */
            font-weight: 500; /* Rótulos com peso 500 */
            line-height: 1.4; /* Espaçamento entre linhas se houver quebra, ou para melhor leitura */
        }

        .footer-summary > div:first-child {
            margin-bottom: 0.5em; /* Pequeno espaço entre "Total de itens" e "Total do pedido" */
        }

        /* Estilos para os SPANs que contêm os valores numéricos e símbolos */
        .footer-summary span {
            font-weight: 700; /* Todos os valores/símbolos em negrito */
        }

        .footer-summary span#cart-count {
            color: #1E1E1E; /* Cor preta para a contagem de itens */
        }

        .footer-summary .currency-symbol,
        .footer-summary span#total-price {
            color: #426B1F;
        }

        .footer .button {
            background: #426B1F;
            color: white;
            font-size: 16px;
            font-weight: 600;
            padding: 12px 28px;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            transition: background-color 0.2s ease;
            white-space: nowrap; /* Impede que o texto do botão quebre linha */
        }

        .footer .button:hover {
            background: #365519; /* Um verde um pouco mais escuro para o hover */
        }
    </style>
</head>


<div class="coupon-bar">
    <a onclick="location.href='@Url.Action("Pedido", "Home")'" class="button btn-left">
        <i class="fa-solid fa-arrow-left" style="color: #ffffff;"></i> Voltar</a>
    <button id="cupomButton" type="button" onclick="cupomModal()" class="button btn-right">
        <i class="fa-solid fa-ticket" style="color: #ffffff;"></i> INSIRA AQUI SEU CUPOM!
    </button>
</div>

<!-- Modal do Cupom -->
<div id="cupomModal" class="modal-cupom" style="display:none;">
    <div class="modal-content-cupom">
        <span class="close-cupom" onclick="fecharCupomModal()">&times;</span>
        <h2>Insira seu cupom</h2>

        <input id="cupomInput" type="text" maxlength="20" class="use-keyboard-input" style="width: 100%; margin-bottom: 10px;"></input>

        <button class="confirm-cupom-btn" onclick="confirmarCupom()">Aplicar Cupom</button>
    </div>
</div>


<div class="content">
    @* <section class="section"> *@

    @* </section> *@
    @* <section class="section"> *@

    @* </section> *@
</div>

<div class="footer">
    <div class="footer-summary">
        <div>Itens no carrinho: <span id="cart-count">0</span></div>
        <div>Preço Total: R$ <span id="total-price">0.00</span></div>
    </div>
    <div class="bottom-buttons">
        <button class="cancel-button" onclick="cancel()">Cancelar pedido</button>
        <button class="confirm-button" onclick="mostrarModalFinalizar()">Confirmar pedido</button>
    </div>
</div>

<div id="modalDeletar" class="modal-cupom" style="display:none;">
    <div class="modal-content-cupom">
        <span class="close-deletar" onclick="fecharModalDeletar()">&times;</span>
        <h2>Deseja remover o item?</h2>

        <button class="cancel-deletar-btn" onclick="fecharModalDeletar()">Cancelar</button>
        <button id="confirmarRemocao" class="confirm-deletar-btn" >Remover Item</button>
    </div>
</div>

<!-- Modal de Finalização -->
<div id="modalFinalizar" class="modal-cupom" style="display:none;">
    <div class="modal-content-cupom">
        <span class="close-deletar" onclick="fecharModalFinalizar()">&times;</span>
        <h2 id="finalizarTitulo"></h2>
        <div id="finalizarResumo"></div>
        
    </div>
</div>

<script src="~/js/Cupom.js"></script>
<script src="~/js/editar.js"></script>
<script>
    var descontoCupom = 0;
    var tipoCupom = null;
    const produtosComIngredientes = @Html.Raw(Json.Serialize(ViewBag.IdsComIngredientes));

    function Confirmar() {
        const savedCart = localStorage.getItem("cart");
        const Initial = JSON.parse(savedCart) || [];
        const cart = Initial.filter(item => item.totalItemPrice !== undefined);
        let totalPrice = cart.reduce((sum, item) => sum + parseFloat(item.totalItemPrice), 0);
        cart.push({ totalPrice: totalPrice.toFixed(2) });
        localStorage.setItem("cart", JSON.stringify(cart));
        console.log(cart);

        window.location.href = "@Url.Action("EscolherLocal", "Home")";
    }


    function load() {
        const savedCart = localStorage.getItem("cart");
        if (!savedCart) return;
        const cart = JSON.parse(savedCart);
        let cartCount = cart.length;
        let totalPrice = cart.reduce((sum, item) => sum + parseFloat(item.totalItemPrice), 0);

        document.getElementById("cart-count").innerText = cartCount;
        document.getElementById("total-price").innerText = totalPrice.toFixed(2);

        const contentDiv = document.querySelector(".content");
        contentDiv.innerHTML = '<h2 id="title1"></h2>';

        cart.forEach((item) => {
            const card = document.createElement("div");
            card.className = "card";
            card.innerHTML = `
                <div class="card-details">
                    <div class="burguer-bar">
                        <p class="text-title">${item.name || "Produto"}</p>
                        <div class="burguer-barTrash">
                            <button onclick="abrirModalDeletar('${item.idpedido}')" style="background: none; border: none; cursor: pointer;">
                                <img src="/img/icons/trash-can.svg" alt="Remover">
                            </button>
                        </div>
                    </div>
                    <div class="burguer-bar">
                        <img class="img-card" src="/img/${item.imageUrl || "default-product.png"}" alt="${item.name || "Produto"}">
                        <p class="text-body">${item.description || "Descrição não disponível"}</p>
                    </div>
                    <div class="burguer-bar-footer">
                        <span class="labelNmr">R$${parseFloat(item.totalItemPrice).toFixed(2)}</span>
                            <button class="burguer-bar-footer-button"
                                onclick="salvarEPersonalizar('${item.id}', '${item.idpedido}')">Personalizar Pedido</button>

                        <div class="burguer-bar-buttonQtde">
                            <button class="editarButton" onclick="adjustQty('${item.idpedido}', -1)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 70 70">
                                    <path d="M34.9997 5.8335C18.9288 5.8335 5.83301 18.9293 5.83301 35.0002C5.83301 51.071 18.9288 64.1668 34.9997 64.1668C51.0705 64.1668 64.1663 51.071 64.1663 35.0002C64.1663 18.9293 51.0705 5.8335 34.9997 5.8335ZM46.433 37.1877H23.0997C21.9038 37.1877 20.9122 36.196 20.9122 35.0002C20.9122 33.8043 21.9038 32.8127 23.0997 32.8127H46.433C47.6288 32.8127 48.6205 33.8043 48.6205 35.0002C48.6205 36.196 47.658 37.1877 46.433 37.1877Z" fill="#463B3B"/>
                                </svg>
                            </button>
                            <span class="labelNmr">${item.quantity}</span>
                            <button onclick="adjustQty('${item.idpedido}', 1)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 70 70">
                                    <path d="M35.0002 5.83325C18.9293 5.83325 5.8335 18.9291 5.8335 34.9999C5.8335 51.0708 18.9293 64.1666 35.0002 64.1666C51.071 64.1666 64.1668 51.0708 64.1668 34.9999C64.1668 18.9291 51.071 5.83325 35.0002 5.83325ZM46.6668 37.1874H37.1877V46.6666C37.1877 47.8624 36.196 48.8541 35.0002 48.8541C33.8043 48.8541 32.8127 47.8624 32.8127 46.6666V37.1874H23.3335C22.1377 37.1874 21.146 36.1958 21.146 34.9999C21.146 33.8041 22.1377 32.8124 23.3335 32.8124H32.8127V23.3333C32.8127 22.1374 33.8043 21.1458 35.0002 21.1458C36.196 21.1458 37.1877 22.1374 37.1877 23.3333V32.8124H46.6668C47.8627 32.8124 48.8543 33.8041 48.8543 34.9999C48.8543 36.1958 47.8627 37.1874 46.6668 37.1874Z" fill="#463B3B"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            `;
            contentDiv.appendChild(card);
        });
    }

    function cancel() {
        localStorage.removeItem("cart");
        location.href = '/Pedido'
    }

    function removerItem(idpedido) {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        const updatedCart = cart.filter(item => item.idpedido !== idpedido);
        localStorage.setItem("cart", JSON.stringify(updatedCart));
        load();
    }

    function salvarEPersonalizar(id, idpedido) {
        localStorage.setItem("idpedidoSelecionado", idpedido);
        location.href = `/Cart/Editar?id=${id}`;
    } 

    function adjustQty(idpedido, amount) {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        const item = cart.find(item => item.idpedido === idpedido);

        if (item) {
            // Calcular preço unitário baseado no total atual dividido pela quantidade atual
            const unitPrice = parseFloat(item.totalItemPrice) / item.quantity;

            // Atualizar a quantidade, com no mínimo 1
            item.quantity = Math.max(1, item.quantity + amount);

            // Atualizar o preço total do item
            item.totalItemPrice = (unitPrice * item.quantity).toFixed(2);

            // Salvar o novo estado do carrinho
            localStorage.setItem("cart", JSON.stringify(cart));
        }

        load(); // Recarrega o HTML dinamicamente
    }
    // Modal para confirmação da remoção do item
    function abrirModalDeletar(idpedido) {
        document.getElementById('modalDeletar').style.display = 'flex';
        document.getElementById('confirmarRemocao').onclick = function() {
            removerItem(idpedido);
            fecharModalDeletar();
        };
    }

    function fecharModalDeletar() {
        document.getElementById('modalDeletar').style.display = 'none';
    }

    function mostrarModalFinalizar(){
        if(!cart || cart.length === 0){
            document.getElementById('modalFinalizar').style.display = 'flex';
            titulo.innerText = "Sem item no carrinho";
            resumo.innerHTML = "<p>Adicione pelo menos um item para prosseguir.</p>";
            return;
        } else {
            let totalBruto = cart.reduce((sum, item) => sum + parseFloat(item.totalItemPrice), 0);
            let descontoValor = totalBruto * descontoCupom;
            let total = totalBruto - descontoValor;
            let itens = cart.map(item => 
                `<li>${item.quantity}x ${item.name} - R$${parseFloat(item.totalItemPrice).toFixed(2)}</li>`
            ).join('');
            titulo.innerText = "Resumo do Pedido";
resumo.innerHTML = `
    <div style="padding: 16px; border-radius: 8px; background-color: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.1); max-width: 480px; margin: auto; font-family: 'Poppins', sans-serif; color: #333;">
        <ul style="list-style: disc inside; text-align: left; font-size: 1rem; margin-bottom: 16px; padding-left: 0;">
            ${itens}
        </ul>

        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <span style="color:#b71c1c; font-size: 1rem; font-weight: 500;">Subtotal:</span>
            <span style="color:#b71c1c; font-size: 1rem; font-weight: 700;">R$${totalBruto.toFixed(2)}</span>
        </div>

        ${descontoCupom > 0 ? `
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                <span style="color:#388e3c; font-size: 1rem; font-weight: 500;">Desconto:</span>
                <span style="color:#388e3c; font-size: 1rem; font-weight: 700;">
                    ${tipoCupom === "Porcentagem" ? `-${(descontoCupom * 100).toFixed(0)}%` : ""}
                    -R$${descontoValor.toFixed(2)}
                </span>
            </div>
        ` : ""}

        <div style="border-top: 1px solid #ccc; margin-top: 12px; padding-top: 12px; display: flex; justify-content: space-between;">
            <span style="font-size: 1.1rem; font-weight: 600; color:#426B1F;">Total:</span>
            <span style="font-size: 1.1rem; font-weight: 700; color:#426B1F;">R$${total.toFixed(2)}</span>
        </div>
    </div>
`;
        }
    }

    // Modal para aplicação de cupom
    function cupomModal() {
        if (descontoCupom > 0) {
            alert('Cupom já aplicado! Desconto: R$ ' + (precoAtual * descontoCupom).toFixed(2));
        } else {
            document.getElementById('cupomModal').style.display = 'flex';
            document.getElementById('cupomInput').value = '';
        }
    }
    function fecharCupomModal() {
        document.getElementById("cupomModal").style.display = "none";
        Keyboard.close();
    }
    function confirmarCupom() {
        const cupom = document.getElementById('cupomInput').value;
        if (!cupom) {
            alert('Digite um cupom!');
            return;
        }
        

        fetch('/Order/ApplyCupom?code=' + encodeURIComponent(cupom))
            .then(response => response.json())
            .then(data => {
                if (data.desconto && data.desconto !== 0) {
                    descontoCupom = data.desconto;
                    tipoCupom = data.tipo;
                    let precoAtual = parseFloat(document.getElementById("total-price").innerText);

                    let novoPreco;
                    if (data.tipo === "Porcentagem") {
                        novoPreco = precoAtual - (precoAtual * descontoCupom);
                    } else if (data.tipo === "ValorFixo") {
                        novoPreco = precoAtual - descontoCupom;
                    } else {
                        novoPreco = precoAtual;
                    }

                    if (novoPreco < 0) novoPreco = 0;

                    document.getElementById("total-price").innerText = novoPreco.toFixed(2);
                    // Após calcular o novoPreco (preço com desconto)
                    localStorage.setItem("totalComDesconto", novoPreco.toFixed(2));
                    fecharCupomModal();
                } else {
                    alert('Cupom inválido!');
                }
            });
    }
    function mostrarModalFinalizar() {
        const savedCart = localStorage.getItem("cart");
        const cart = savedCart ? JSON.parse(savedCart) : [];
        const modal = document.getElementById('modalFinalizar');
        const titulo = document.getElementById('finalizarTitulo');
        const resumo = document.getElementById('finalizarResumo');
        const btnContainer = modal.querySelector('.modal-content-cupom');

        const oldBtn = modal.querySelector('#btnFinalizarPedido');
        if (oldBtn) oldBtn.remove();

        let btn;
        if (!cart || cart.length === 0) {
            titulo.innerText = "Sem item no carrinho";
            resumo.innerHTML = "<p>Adicione pelo menos um item para prosseguir.</p>";
            btn = document.createElement('button');
            btn.className = "confirm-deletar-btn";
            btn.id = "btnFinalizarPedido";
            btn.innerText = "Fechar";
            btn.onclick = fecharModalFinalizar;
        } else {
            // Monta o resumo do pedido
            let totalBruto = cart.reduce((sum, item) => sum + parseFloat(item.totalItemPrice), 0);
            let descontoValor = 0;
            if (tipoCupom === "Porcentagem") {
                descontoValor = totalBruto * descontoCupom;
            } else if (tipoCupom === "ValorFixo") {
                descontoValor = descontoCupom;
            }
            if (descontoValor > totalBruto) descontoValor = totalBruto; // nunca maior que o total
            let total = totalBruto - descontoValor;
            if (total < 0) total = 0;
            let itens = cart.map(item => 
                `<li>${item.quantity}x ${item.name} - R$${parseFloat(item.totalItemPrice).toFixed(2)}</li>`
            ).join('');
            titulo.innerText = "Resumo do Pedido";
            let descontoTexto = "";
            if (descontoCupom > 0) {
                if (tipoCupom === "Porcentagem") {
                    descontoTexto = `<p><span style="color:#388e3c; font-size:0.95em;">Desconto: -${(descontoCupom * 100).toFixed(0)}% (-R$${descontoValor.toFixed(2)})</span></p>`;
                } else if (tipoCupom === "ValorFixo") {
                    descontoTexto = `<p><span style="color:#388e3c; font-size:0.95em;">Desconto: -R$${descontoValor.toFixed(2)}</span></p>`;
                }
            }

            resumo.innerHTML = `<ul style="text-align:left;">${itens}</ul>
                <p><span style="color:#b71c1c; font-size:0.95em;">Subtotal: R$${totalBruto.toFixed(2)}</span></p>
                ${descontoTexto}
                <p><strong>Total: R$${total.toFixed(2)}</strong></p>`;
            btn = document.createElement('button');
            btn.className = "confirm-deletar-btn";
            btn.id = "btnFinalizarPedido";
            btn.innerText = "Prosseguir para o pagamento";
            btn.onclick = function() {
                location.href = '@Url.Action("EscolherLocal", "Finalization")';
            };
        }
        btnContainer.appendChild(btn);
        modal.style.display = 'flex';
    }

    function fecharModalFinalizar() {
        document.getElementById('modalFinalizar').style.display = 'none';
    }

    window.onload = function() {
        // Verifica se o cliente está logado com CPF
        const clienteCPF = localStorage.getItem("clienteCPF");
        const cupomBtn = document.getElementById('cupomButton');
        if (cupomBtn) {
            cupomBtn.style.display = clienteCPF ? 'inline-flex' : 'none';
        }
        load();
    };
</script>