@model TotemPWA.Models.Cupom
@{
    ViewBag.Title = "Cupom";
    Layout = "~/Views/Shared/_WelcomeLayout.cshtml";
}

<style>
    .container.mt-5, .container.py-5 {
        background: #fff;
        border-radius: 14px;
        justify-self: center;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 40px 32px 32px 32px;
        max-width: 600px;
        margin-top: 48px;
    }
    h1 {
        font-size: 2.2rem;
        font-weight: 700;
        color: #b71c1c;
        margin-bottom: 40px;
        text-align: center;
        letter-spacing: 1px;
    }
    .mb-3 {
        margin-bottom: 1.7rem !important;
    }
    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 6px;
    }
    .form-control, .form-select, .form-control-lg, .form-select-lg {
        border-radius: 8px;
        border: 1.5px solid #e0e0e0;
        font-size: 1.08rem;
        padding: 10px 14px;
        transition: border 0.2s;
    }
    .form-control:focus, .form-select:focus, .form-control-lg:focus, .form-select-lg:focus {
        border-color: #b71c1c;
        box-shadow: 0 0 0 2px #c1d34344;
    }
    .btn-success, .btn-primary {
        background: #b71c1c;
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 8px;
        padding: 10px 28px;
        font-size: 1.1rem;
        margin-right: 16px;
        transition: background 0.2s;
    }
    .btn-success:hover, .btn-primary:hover {
        background: #a31515;
    }
    .btn-outline-secondary, .btn-secondary {
        background: #c1d343;
        color: #b71c1c;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        padding: 10px 28px;
        font-size: 1.1rem;
        transition: background 0.2s;
    }
    .btn-outline-secondary:hover, .btn-secondary:hover {
        background: #b6c12f;
        color: #b71c1c;
    }
    .contentIngredient {
        background: #f7f7f7;
        border-radius: 10px;
        padding: 22px 20px 18px 20px;
        margin-bottom: 22px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
    }
    .contentIngredient h2 {
        font-size: 1.3rem;
        font-weight: 600;
        color: #b71c1c;
        margin: 0;
        flex: 1;
    }
    .contentIngredient form,
    .contentIngredient .btn.btn-primary {
        margin-left: 10px;
    }
    .btn.btn-danger {
        background: #b71c1c;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 20px;
        font-size: 1rem;
        font-weight: 600;
        margin-right: 8px;
        transition: background 0.2s;
    }
    .btn.btn-danger:hover {
        background: #a31515;
    }
    /* Espaço maior entre título e botões */
    form .btn, .d-flex.justify-content-between .btn {
        margin-top: 32px;
    }
    .fotoIngrediente {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        margin-right: 16px;
        border: 1px solid #eee;
        background: #fafafa;
    }
</style>

<form asp-action="Editar" method="post">
    <div class="container mt-5">
        <h1>Editar Cupom</h1>
        <input type="hidden" asp-for="Codigo" />

        <div class="mb-3">
            <label asp-for="Codigo" class="form-label">Código</label>
            <input asp-for="Codigo" class="form-control" readonly />
            <span asp-validation-for="Codigo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Desconto" class="form-label">Desconto</label>
            <input asp-for="Desconto" class="form-control" required type="number" step="0.01" />
            <span asp-validation-for="Desconto" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label">Tipo</label>
            <select asp-for="Type" class="form-control">
                <option value="Porcentagem">Porcentagem (%)</option>
                <option value="ValorFixo">Valor Fixo (R$)</option>
            </select>
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Salvar Alterações</button>
        <button asp-action="Index" class="btn btn-primary">Cancelar</button>
    </div>
</form>