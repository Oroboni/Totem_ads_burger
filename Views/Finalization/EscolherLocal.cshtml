@{
    ViewData["Title"] = "Escolha a Consumação";
    Layout = null; // Ignora o layout padrão
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        .bg-diagonal-split {
            background: linear-gradient(to bottom right, #a3a000 0%, #a3a000 50%, #9fcc3b 50%, #9fcc3b 100%);
        }
    </style>
</head>

<body class="bg-diagonal-split min-h-screen flex flex-col">

    <header class="p-4">
        <button onclick="history.back()"
            class="bg-gray-800 hover:bg-gray-700 text-white text-sm font-semibold py-2 px-4 rounded-full inline-flex items-center space-x-2 transition duration-150 ease-in-out">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Voltar</span>
        </button>
    </header>

    <main class="flex-grow flex flex-col justify-center items-center px-4 pb-8">

        <h1 class="text-white text-4xl md:text-5xl font-bold text-center mb-12 leading-tight">
            ESCOLHA<br>SUA<br>CONSUMAÇÃO
        </h1>

        <div class="flex flex-col md:flex-row gap-6 md:gap-10">
            <div class="bg-white rounded-2xl shadow-lg p-5 flex flex-col items-center text-center w-60 md:w-72 cursor-pointer hover:scale-105 transition-transform duration-200 ease-in-out"
                onclick="carrinho('Viagem')">
                <img src="~/img/LevarParaViagem.png" alt="Embalagens para levar"
                    class="w-60 h-60 object-contain mb-4" />
                <span class="font-semibold text-lg" style="color: #5f7c10;">Levarei para viagem</span>
            </div>


            <div class="bg-white rounded-2xl shadow-lg p-5 flex flex-col items-center text-center w-60 md:w-72 cursor-pointer hover:scale-105 transition-transform duration-200 ease-in-out"
                onclick="carrinho('Local')">
                <img src="~/img/ComerNoLocal.png" alt="Bandeja com lanche" class="w-60 h-60 object-contain mb-4" />
                <span class="font-semibold text-lg" style="color: #5f7c10;">Comerei no local</span>
            </div>
        </div>
    </main>

</body>

</html>
<script>
    function carrinho(Local) {
        const savedCart = localStorage.getItem("cart");
        const Initial = JSON.parse(savedCart);
        const cart = Initial.filter(item => !item.Local);
        cart.push({ Local });
        localStorage.setItem("cart", JSON.stringify(cart));
        window.location.href = "@Url.Action("CPFnaNota", "Finalization")";
    }
</script>